# Copy to .dev.vars for local development; never commit real credentials.
AGENT_DEFAULT_API_KEY=""
AGENT_DEFAULT_MODEL="anthropic/claude-haiku-5.5"
# Production: bind the shared default to your authenticated Site owner.
AGENT_DEFAULT_OWNER_ID=""
AGENT_DEFAULT_OWNER_EMAIL=""
# Generate a stable 32-byte encryption key: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key stable: saved provider credentials are encrypted with it.
AGENT_ENCRYPTION_KEY=""
